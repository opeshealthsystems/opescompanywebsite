{
  "expo": {
    "name": "OPES Health",
    "slug": "opes-health",
    "owner": "opesware",
    "scheme": "opeshealth",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "updates": {
      "url": "https://u.expo.dev/fe0233dc-7a40-44f4-9007-383477435ba0",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-updates",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 210,
          "resizeMode": "contain",
          "backgroundColor": "#F5F8FC",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#F5F8FC"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.opeshealthsystems.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#082D55"
      }
    },
    "ios": {
      "bundleIdentifier": "com.opeshealthsystems.mobile",
      "supportsTablet": true
    },
    "userInterfaceStyle": "light",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fe0233dc-7a40-44f4-9007-383477435ba0"
      }
    }
  }
}
